{
  // markdownlint-cli2 configuration
  // Target: CommonMark (Zola's parser)
  "config": {
    "default": true,
    // Zola uses TOML front matter delimited by +++
    "frontMatter": "^\\+\\+\\+[\\s\\S]*?\\+\\+\\+",
    // Line length: not enforced — prose content has long lines by nature
    "MD013": false,
    // First line must be heading: disabled — front matter provides the title
    "MD041": false,
    // Emphasis as heading: disabled — _Last updated: …_ is metadata, not a heading substitute
    "MD036": false,
  },
  "ignores": [
    // Auto-generated by Changesets; not hand-authored
    "CHANGELOG.md",
    ".changeset/**",
    "node_modules/**",
  ],
}
