# GitHub Actions secrets (Settings → Secrets and variables → Actions → Secrets)
AWS_ACCESS_KEY_ID=your-garage-access-key-id
AWS_SECRET_ACCESS_KEY=your-garage-secret-access-key
AWS_REGION=your-garage-aws-region
S3_BUCKET=your-s3-bucket-name

# GitHub Actions variables (Settings → Secrets and variables → Actions → Variables)
SITE_BASE_URL=https://your-garage-site-url
