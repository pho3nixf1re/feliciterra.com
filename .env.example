# GHCR credentials (for Watchtower to pull updates)
GHCR_USER=your-github-username
GHCR_TOKEN=your-ghcr-personal-access-token

# Full GHCR image path, e.g. ghcr.io/your-org/feliciterra.com:latest
SITE_IMAGE=ghcr.io/your-org/feliciterra.com:latest

# Port the site container exposes on the host
SITE_PORT=8080

# Watchtower polling interval in seconds
WATCHTOWER_POLL_INTERVAL=300
