{
  "extends": ["stylelint-config-standard", "stylelint-config-standard-scss"],
  "rules": {
    "at-rule-no-unknown": null,
    "scss/at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": ["plugin", "source", "theme", "utility", "variant", "slot"]
      }
    ],
    "import-notation": null
  }
}
